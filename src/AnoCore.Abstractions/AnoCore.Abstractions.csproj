<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AnoCore.Abstractions</AssemblyName>
    <RootNamespace>AnoCore.Abstractions</RootNamespace>
    <PackageId>AnoCore.Abstractions</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>AnoCore contributors</Authors>
    <Description>Public contracts for building modules against AnoCore.</Description>
    <PackageTags>anocore;cs2;modules;sdk</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/nfloser/AnoCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="" />
    <None Include="SDK-README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
