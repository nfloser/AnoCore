<root>
  <styles>
    <include src="s2r://panorama/styles/custom_game/anocore/ano_casino_slots.vcss_c" />
  </styles>
  <Panel class="ano-hud-host" hittest="false">
    <Panel id="casino_slots_root" class="casino-overlay" hittest="true">
      <Panel class="casino-dim" hittest="false" />
