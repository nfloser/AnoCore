              <Panel class="casino-symbol symbol-plum slot-row-10" />
              <Panel class="casino-symbol symbol-orange slot-row-11" />
              <Panel class="casino-symbol symbol-grapes slot-row-12" />
              <Panel class="casino-symbol symbol-watermelon slot-row-13" />
              <Panel class="casino-symbol symbol-bell slot-row-14" />
              <Panel class="casino-symbol symbol-seven slot-row-15" />
